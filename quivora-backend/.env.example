# Quivora Backend — environment variables template
# Copy to .env and fill in values

QUIVORA_DATABASE_URL=postgresql+psycopg2://quivora:quivora@localhost:5434/quivora
QUIVORA_REDIS_URL=redis://localhost:6379/0
QUIVORA_API_KEY=quivora-dev-key
QUIVORA_TRAIN_TOTAL_SECONDS=120.0
QUIVORA_TRAIN_FAST=0
QUIVORA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Telegram (optional)
# QUIVORA_TELEGRAM_BOT_TOKEN=
# QUIVORA_TELEGRAM_BOT_USERNAME=
# QUIVORA_TELEGRAM_TEST_RECIPIENT=

# India SMS — Fast2SMS Quick route (free signup credit, no DLT for demo)
# Sign up: https://www.fast2sms.com → Dev API → copy Authorization key
# QUIVORA_SMS_PROVIDER=auto
# QUIVORA_FAST2SMS_API_KEY=
# Without a key, provider=auto uses free local "log" mode (SMS printed to API logs)
