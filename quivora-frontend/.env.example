# Quivora Frontend — environment variables template
# Copy to .env.local and fill in values

# Server-only backend URL for the Next.js BFF (never expose API keys to the browser)
QUIVORA_API_BASE=http://127.0.0.1:8100

# Optional legacy dev fallback — prefer QUIVORA_API_BASE only
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8100
